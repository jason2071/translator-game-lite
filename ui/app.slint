import { Button, LineEdit, CheckBox, ComboBox, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export struct EntryRow {
    id: string,
    original: string,
    translation: string,
    speaker: string,
    status: string,
    file: string,
}

export struct GlossaryRow {
    id: string,
    source: string,
    target: string,
    note: string,
    enabled: bool,
}

export struct GlossaryProposalRow {
    id: string,
    source: string,
    target: string,
    occurrences: int,
}

export struct QaRow {
    id: string,
    loc: string,
    label: string,
}

export struct ContextInfo {
    speaker: string,
    scene: string,
    previous: string,
    next: string,
}

export struct ProfileRow {
    id: string,
    name: string,
    model: string,
    endpoint: string,
}

component ProgressBar inherits Rectangle {
    in property <float> progress; // 0..1
    background: #e4e6ec;
    border-radius: 4px;
    Rectangle {
        x: 0;
        y: 0;
        height: parent.height;
        width: parent.width * clamp(parent.progress, 0, 1);
        background: #1c5fd6;
        border-radius: 4px;
    }
}

component StatBox inherits Rectangle {
    in property <string> label;
    in property <int> value;
    in property <color> accent;
    border-radius: 8px;
    background: #f5f6fa;
    min-height: 58px;
    VerticalLayout {
        padding: 10px;
        alignment: center;
        Text {
            text: "\{root.value}";
            font-size: 22px;
            font-weight: 700;
            color: root.accent;
            horizontal-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: #666;
            horizontal-alignment: center;
        }
    }
}

component FieldLabel inherits Text {
    font-size: 11px;
    color: #777;
}

/// Square icon button (refresh, close, add, edit, delete, ...).
component IconButton inherits Rectangle {
    in property <image> source;
    in property <bool> enabled: true;
    callback clicked();
    border-radius: 6px;
    opacity: root.enabled ? 1 : 0.35;
    background: ta.has-hover ? #e4e8f2 : transparent;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Image {
        source: root.source;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component SectionCard inherits Rectangle {
    background: #f8f9fc;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e6e8ef;
}

component SectionTitle inherits Text {
    font-weight: 700;
    font-size: 13px;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 38px;
    border-radius: 6px;
    background: root.active ? #fde3ef : ta.has-hover ? #f0f0f4 : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Text {
        text: root.label;
        vertical-alignment: center;
        font-size: 13px;
        color: root.active ? #c2417c : #333;
        font-weight: root.active ? 700 : 400;
        x: 10px;
    }
}

/// Flat button for dialogs: neutral (Cancel), red (Delete) or blue (Confirm).
component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> danger;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    min-width: 96px;
    border-radius: 7px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.danger
        ? (ta.pressed ? #b91c1c : ta.has-hover ? #dc2626 : #ef4444)
        : root.primary
            ? (ta.pressed ? #174a9f : ta.has-hover ? #1a55bd : #1c5fd6)
            : (ta.pressed ? #d8dbe3 : ta.has-hover ? #e4e7ee : #eef0f5);
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
    Text {
        text: root.label;
        font-size: 13px;
        font-weight: 600;
        color: root.danger || root.primary ? white : #333;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Dimmed overlay covering the whole window with a centered card.
component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    callback accepted();
    callback rejected();
    background: #00000066;
    TouchArea {
        clicked => { root.rejected(); } // click on the dimmed area = cancel
    }
    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        init => { fs.focus(); }
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.rejected();
                accept
            } else if e.text == Key.Return {
                root.accepted();
                accept
            } else {
                reject
            }
        }
        Rectangle {
            width: 430px;
            height: 208px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000045;
            TouchArea {} // swallow clicks so the card body is not "outside"
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 700;
                    color: #1a1a1a;
                }
                Text {
                    text: root.message;
                    font-size: 13px;
                    color: #555;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: "Cancel";
                        clicked => { root.rejected(); }
                    }
                    DialogButton {
                        label: "Delete";
                        danger: true;
                        clicked => { root.accepted(); }
                    }
                }
            }
        }
    }
}

// ============================================================ main window

export component AppWindow inherits Window {
    title: "Game Translator v0.1";
    icon: @image-url("assets/app-icon.png");
    preferred-width: 1180px;
    preferred-height: 720px;
    background: white;

    in-out property <int> current-tab; // 0 = project, 1 = glossary, 2 = settings

    // ---- project
    in-out property <string> project-path;
    in property <string> engine-name;
    in property <int> stat-total;
    in property <int> stat-translated;
    in property <int> stat-pending;
    in property <int> stat-failed;

    // ---- entries
    in property <[EntryRow]> entries;
    in property <int> page;          // 0-based
    in property <int> page-count;
    in-out property <string> sel-id;
    in property <string> sel-original;
    in property <string> sel-status;
    in-out property <string> sel-translation;
    in property <string> sel-glossary-hint;
    in property <ContextInfo> sel-context;
    in-out property <string> entry-search;
    in-out property <bool> entry-search-case; // match case
    in-out property <bool> entry-search-word; // match whole word
    in-out property <int> status-filter-index; // 0=All, 1=Pending, 2=Translated, 3=Failed

    // ---- glossary
    in property <[GlossaryRow]> glossary;
    in-out property <string> glossary-search;
    in-out property <string> gl-id;
    in-out property <string> gl-source;
    in-out property <string> gl-target;
    in-out property <string> gl-note;
    in property <[GlossaryProposalRow]> gp-rows;
    in-out property <bool> gp-visible;
    in-out property <bool> gp-busy; // AI extraction in progress
    in-out property <string> gp-status;

    // ---- settings / AI profiles
    in-out property <int> section; // 0 = AI Profiles, 1 = Translation, 2 = Prompt
    in property <[ProfileRow]> profile-rows;
    in property <[string]> translation-profile-items;
    in-out property <int> translation-profile-index;
    in property <[string]> glossary-profile-items;
    in-out property <int> glossary-profile-index;
    in-out property <string> set-source-lang;
    in-out property <string> set-target-lang;
    in-out property <string> set-batch-size;
    in-out property <string> set-concurrency;
    in-out property <string> set-context-before;
    in-out property <string> set-context-after;
    in-out property <string> set-prompt;
    in-out property <bool> set-export-to-none;

    // ---- worker state
    in property <bool> running;
    in property <float> progress; // 0..1
    in-out property <string> status-message;

    // ---- delete confirmation modal
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-kind; // "profile" | "glossary"
    in-out property <string> confirm-pending-id;
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;

    // ---- AI profile add/edit overlay
    in-out property <bool> ed-visible;
    in-out property <string> ed-name;
    in-out property <int> ed-preset;
    in-out property <string> ed-endpoint;
    in-out property <string> ed-api-key;
    in property <[string]> ed-model-items;
    in-out property <int> ed-model-index;
    in-out property <string> ed-model;
    in-out property <string> ed-temperature;
    in-out property <string> ed-error;

    // ---- folder picker overlay (replaces the native file dialog)
    in-out property <bool> fp-visible;
    in-out property <string> fp-path;   // current directory ("" = drive list)
    in property <[string]> fp-items;    // subdirectories, ".." first
    in-out property <string> fp-status; // error line

    // ---- bulk re-translate confirmation
    in-out property <bool> rt-visible;
    in-out property <int> rt-scope;      // 0 = current search/filter, 1 = whole project
    in-out property <bool> rt-ignore-tm; // skip translation memory for this run

    // ---- QA report
    in property <[QaRow]> qa-rows;
    in-out property <bool> qa-visible;
    in-out property <string> qa-summary;

    // ---- find & replace (translations only)
    in-out property <bool> fr-visible;
    in-out property <string> fr-find;
    in-out property <string> fr-replace;
    in-out property <bool> fr-case;
    in-out property <bool> fr-word;
    in property <[string]> fr-preview;
    in-out property <string> fr-count;

    callback browse-project();
    callback scan-project();
    callback start-translate();
    callback cancel-translate();
    callback do-export();
    callback prev-page();
    callback next-page();
    callback select-entry(string);
    callback save-edit();
    callback retranslate-entry();
    callback glossary-new();
    callback glossary-load(string);
    callback glossary-save();
    callback glossary-delete(string);
    callback glossary-toggle(string, bool);
    callback apply-glossary-search(string);
    callback apply-entry-search(string);
    callback profile-edit(string);
    callback profile-delete(string);
    callback profile-add();
    callback pick-translation-profile(string);
    callback pick-glossary-profile(string);
    callback save-source-lang(string);
    callback save-target-lang(string);
    callback save-batch-size(string);
    callback save-concurrency(string);
    callback save-context-before(string);
    callback save-context-after(string);
    callback save-prompt(string);
    callback save-export-to-none(bool);
    callback close-editor();
    callback confirm-delete();
    callback cancel-delete();
    callback ed-apply-preset(string);
    callback ed-refresh-models();
    callback ed-apply-model(string);
    callback ed-confirm();
    callback ed-cancel();
    callback fp-navigate(string);
    callback fp-go();
    callback fp-confirm();
    callback fp-cancel();
    callback retranslate-open();
    callback rt-confirm();
    callback rt-cancel();
    callback qa-check();
    callback qa-jump(string);
    callback fr-preview-run();
    callback fr-replace-all();
    callback fr-cancel();
    callback fr-open();
    callback extract-glossary();
    callback gp-accept(string);
    callback gp-reject(string);
    callback gp-accept-all();
    callback gp-discard();

    VerticalLayout {
        // ================================================== header / toolbar
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                text: "Game Translator";
                font-size: 17px;
                font-weight: 700;
                vertical-alignment: center;
            }
            LineEdit {
                text <=> root.project-path;
                read-only: true;
                min-width: 260px;
            }
            Button { text: "Open"; clicked => { root.browse-project(); } }
            Button { text: "Scan"; enabled: root.project-path != ""; clicked => { root.scan-project(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Project"; clicked => { root.current-tab = 0; } }
            Button { text: "Glossary"; clicked => { root.current-tab = 1; } }
            Button { text: "Settings"; clicked => { root.current-tab = 2; } }
        }

        // ================================================== content
        Rectangle {
            vertical-stretch: 1;

                    if root.current-tab == 0 : VerticalLayout {
                // ------------------------------------------------- stats
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    StatBox { label: "Total"; value: root.stat-total; accent: #333; }
                    StatBox { label: "Translated"; value: root.stat-translated; accent: #1a7f37; }
                    StatBox { label: "Pending"; value: root.stat-pending; accent: #b58900; }
                    StatBox { label: "Failed"; value: root.stat-failed; accent: #c62828; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: "Engine: " + (root.engine-name == "" ? "—" : root.engine-name); color: #666; }
                    }
                }

                // --------------------------------- table + editor panel
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    vertical-stretch: 1;

                    // ---- entry table
                    VerticalLayout {
                        horizontal-stretch: 3;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "Status";
                                font-size: 11px;
                                color: #777;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                width: 120px;
                                model: ["All", "Pending", "Translated", "Failed"];
                                current-index <=> root.status-filter-index;
                                selected(text) => { root.apply-entry-search(root.entry-search); }
                            }
                            LineEdit {
                                placeholder-text: "Search original / translation";
                                text <=> root.entry-search;
                                horizontal-stretch: 1;
                                edited(text) => { root.apply-entry-search(text); }
                            }
                            CheckBox {
                                text: "Match case";
                                checked <=> root.entry-search-case;
                                toggled => { root.apply-entry-search(root.entry-search); }
                            }
                            CheckBox {
                                text: "Whole word";
                                checked <=> root.entry-search-word;
                                toggled => { root.apply-entry-search(root.entry-search); }
                            }
                            Button {
                                text: "Replace";
                                clicked => { root.fr-open(); }
                            }
                        }
                        // Header + row delegates MUST use the same column math.
                        // A HorizontalLayout distributes space by stretch *plus*
                        // each label's min text width, which drifts a few px from
                        // the fixed formula, so both sides position absolutely.
                        header := Rectangle {
                            height: 30px;
                            background: #eef0f5;
                            border-radius: 4px;
                            property <length> colw: (header.width - 20px - 90px) / 2;
                            Text {
                                x: 10px;
                                width: header.colw;
                                text: "Original";
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                x: 10px + header.colw;
                                width: header.colw;
                                text: "Translation";
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                x: 10px + header.colw * 2;
                                width: 90px;
                                text: "Status";
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for row[idx] in root.entries: rowrect := Rectangle {
                                height: 38px;
                                background: row.id == root.sel-id ? #eaf1fd
                                    : Math.mod(idx, 2) == 0 ? white : #f7f8fb;
                                property <length> colw: (rowrect.width - 20px - 90px) / 2;
                                Text { // Original column
                                    x: 10px;
                                    width: rowrect.colw;
                                    height: parent.height;
                                    text: row.original;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: #222;
                                }
                                Text { // Translation column
                                    x: 10px + rowrect.colw;
                                    width: rowrect.colw;
                                    height: parent.height;
                                    text: row.translation;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: #111;
                                }
                                Text { // Status column
                                    x: 10px + rowrect.colw * 2;
                                    width: 90px;
                                    height: parent.height;
                                    text: row.status == "" ? "pending" : row.status;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    color: #555;
                                }
                                TouchArea {
                                    clicked => { root.select-entry(row.id); }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;
                            Button { text: "◀ Prev"; enabled: root.page > 0; clicked => { root.prev-page(); } }
                            Text {
                                text: "Page " + (root.page + 1) + " / " + root.page-count;
                                vertical-alignment: center;
                                color: #555;
                            }
                            Button { text: "Next ▶"; enabled: root.page < root.page-count - 1; clicked => { root.next-page(); } }
                        }
                    }

                    // ---- editor panel
                    if root.sel-id != "" : VerticalLayout {
                        width: 380px;
                        spacing: 8px;
                        Rectangle {
                            clip: true;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e2e4ea;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 8px;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        FieldLabel { text: "ORIGINAL"; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        IconButton {
                                            source: @image-url("assets/x.svg");
                                            clicked => { root.close-editor(); }
                                        }
                                    }
                                Rectangle {
                                    background: #f7f8fa;
                                    border-radius: 6px;
                                    min-height: 56px;
                                    max-height: 90px;
                                    ScrollView {
                                        Text {
                                            text: root.sel-original;
                                            wrap: word-wrap;
                                            font-size: 13px;
                                            color: #222;
                                        }
                                    }
                                }

                                FieldLabel { text: "CONTEXT"; }
                                Rectangle {
                                    background: #f7f8fa;
                                    border-radius: 6px;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        if root.sel-context.speaker != "" : Text { text: "Speaker: " + root.sel-context.speaker; font-size: 12px; color: #444; }
                                        if root.sel-context.scene != "" : Text { text: "Scene: " + root.sel-context.scene; font-size: 12px; color: #444; }
                                        if root.sel-context.previous != "" : Text { text: "Previous: " + root.sel-context.previous; font-size: 12px; color: #666; wrap: word-wrap; }
                                        Text { text: "Current: " + root.sel-original; font-size: 12px; color: #111; font-weight: 600; wrap: word-wrap; }
                                        if root.sel-context.next != "" : Text { text: "Next: " + root.sel-context.next; font-size: 12px; color: #666; wrap: word-wrap; }
                                    }
                                }

                                if root.sel-glossary-hint != "" : FieldLabel { text: "GLOSSARY"; }
                                if root.sel-glossary-hint != "" : Text {
                                    text: root.sel-glossary-hint;
                                    font-size: 12px;
                                    color: #8a5a00;
                                    wrap: word-wrap;
                                }

                                FieldLabel { text: "TRANSLATION  (status: " + root.sel-status + ")"; }
                                Rectangle {
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #d5d8e0;
                                    min-height: 90px;
                                    TextEdit {
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> root.sel-translation;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Save"; clicked => { root.save-edit(); } }
                                    Button { text: "Re-translate"; enabled: !root.running; clicked => { root.retranslate-entry(); } }
                                }
                            }
                        }
                    }
                }

                // ------------------------------------------------ bottom bar
                HorizontalLayout {
                    padding: 10px;
                    spacing: 10px;
                    Text {
                        text: "Provider";
                        font-size: 11px;
                        color: #777;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        width: 180px;
                        model: root.translation-profile-items;
                        current-index <=> root.translation-profile-index;
                        selected(text) => { root.pick-translation-profile(text); }
                    }
                    if !root.running : Button {
                        text: "Translate";
                        primary: true;
                        enabled: root.project-path != "";
                        clicked => { root.start-translate(); }
                    }
                    if !root.running : Button {
                        text: "Re-translate";
                        enabled: root.project-path != "";
                        clicked => { root.retranslate-open(); }
                    }
                    if root.running : Button {
                        text: "Cancel";
                        clicked => { root.cancel-translate(); }
                    }
                    ProgressBar {
                        horizontal-stretch: 1;
                        progress: root.progress;
                    }
                    Button {
                        text: "QA Check";
                        enabled: root.project-path != "" && !root.running;
                        clicked => { root.qa-check(); }
                    }
                    Button {
                        text: "Export";
                        enabled: root.project-path != "" && !root.running;
                        clicked => { root.do-export(); }
                    }
                }
            }

            if root.current-tab == 1 : VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        placeholder-text: "Search glossary";
                        text <=> root.glossary-search;
                        min-width: 240px;
                        edited(text) => { root.apply-glossary-search(text); }
                    }
                    Text {
                        text: "Extraction provider";
                        font-size: 11px;
                        color: #777;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        width: 200px;
                        model: root.glossary-profile-items;
                        current-index <=> root.glossary-profile-index;
                        selected(text) => { root.pick-glossary-profile(text); }
                    }
                    IconButton {
                        source: @image-url("assets/wand.svg");
                        enabled: root.project-path != "" && !root.gp-busy;
                        clicked => { root.extract-glossary(); }
                    }
                    Text {
                        text: "Extract with AI";
                        font-size: 11px;
                        color: #777;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        source: @image-url("assets/plus.svg");
                        clicked => { root.glossary-new(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: "Source term"; text <=> root.gl-source; min-width: 200px; }
                    LineEdit { placeholder-text: "Translation"; text <=> root.gl-target; min-width: 200px; }
                    LineEdit { placeholder-text: "Note (optional)"; text <=> root.gl-note; }
                    Button {
                        text: root.gl-id == "" ? "Add" : "Update";
                        clicked => { root.glossary-save(); }
                    }
                }

                // header
                Rectangle {
                    height: 26px;
                    background: #eef0f5;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px; // matches the row delegates below
                        Text { text: "Source"; width: 200px; font-weight: 600; vertical-alignment: center; }
                        Text { text: "Translation"; width: 220px; font-weight: 600; vertical-alignment: center; }
                        Text { text: "Note"; font-weight: 600; vertical-alignment: center; }
                        Text { text: "On"; width: 40px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        Text { text: ""; width: 110px; }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for g in root.glossary: Rectangle {
                        height: 32px;
                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 4px;
                            Text { text: g.source; width: 200px; vertical-alignment: center; }
                            Text { text: g.target; width: 220px; vertical-alignment: center; }
                            Text { text: g.note; overflow: elide; vertical-alignment: center; color: #666; }
                            CheckBox {
                                width: 40px;
                                checked: g.enabled;
                                toggled => { root.glossary-toggle(g.id, self.checked); }
                            }
                            Rectangle {
                                width: 110px;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    IconButton {
                                        source: @image-url("assets/edit.svg");
                                        clicked => { root.glossary-load(g.id); }
                                    }
                                    IconButton {
                                        source: @image-url("assets/trash.svg");
                                        clicked => { root.glossary-delete(g.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ============================================== settings tab
            if root.current-tab == 2 : HorizontalLayout {
                // ---------------------------------------------- sidebar
                VerticalLayout {
                    width: 190px;
                    padding: 12px;
                    spacing: 4px;
                    NavItem {
                        label: "AI Profiles";
                        active: root.section == 0;
                        clicked => { root.section = 0; }
                    }
                    NavItem {
                        label: "Translation";
                        active: root.section == 1;
                        clicked => { root.section = 1; }
                    }
                    NavItem {
                        label: "Prompt";
                        active: root.section == 2;
                        clicked => { root.section = 2; }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
                Rectangle { width: 1px; background: #e6e8ef; }

                // ---------------------------------------------- content
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 10px;

                            if root.section == 0 : SectionCard {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    SectionTitle { text: "AI Profiles"; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "saved connections — pick where to use them: Project (translation) and Glossary (extraction)";
                                        font-size: 11px;
                                        color: #999;
                                        vertical-alignment: center;
                                    }
                                    IconButton {
                                        source: @image-url("assets/plus.svg");
                                        clicked => { root.profile-add(); }
                                    }
                                }

                                Rectangle {
                                    height: 26px;
                                    background: #eef0f5;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 6px; // matches the row delegates below
                                        Text { text: "Name"; width: 190px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        Text { text: "Model"; width: 210px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        Text { text: "Endpoint"; horizontal-stretch: 1; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        Text { text: ""; width: 90px; }
                                    }
                                }
                                ListView {
                                    min-height: 280px;
                                    for p in root.profile-rows: Rectangle {
                                        height: 46px;
                                        background: white;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            spacing: 6px;
                                            VerticalLayout {
                                                width: 190px;
                                                alignment: center;
                                                Text {
                                                    text: p.name;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: p.model;
                                                width: 210px;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                font-size: 12px;
                                                color: #555;
                                            }
                                            Text {
                                                text: p.endpoint;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                font-size: 12px;
                                                color: #888;
                                            }
                                            Rectangle {
                                                width: 90px;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 4px;
                                                    IconButton {
                                                        source: @image-url("assets/edit.svg");
                                                        clicked => { root.profile-edit(p.id); }
                                                    }
                                                    IconButton {
                                                        source: @image-url("assets/trash.svg");
                                                        clicked => { root.profile-delete(p.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if root.section == 1 : SectionCard {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                SectionTitle { text: "Translation"; }
                                Text {
                                    text: "Saved automatically as you type.";
                                    font-size: 11px;
                                    color: #888;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Source Language"; }
                                        LineEdit {
                                            text <=> root.set-source-lang;
                                            edited(text) => { root.save-source-lang(text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Target Language"; }
                                        LineEdit {
                                            text <=> root.set-target-lang;
                                            edited(text) => { root.save-target-lang(text); }
                                        }
                                    }
                                    Rectangle { }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Batch Size (entries/request)"; }
                                        LineEdit {
                                            text <=> root.set-batch-size;
                                            input-type: number;
                                            edited(text) => { root.save-batch-size(text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Concurrency (requests in parallel)"; }
                                        LineEdit {
                                            text <=> root.set-concurrency;
                                            input-type: number;
                                            edited(text) => { root.save-concurrency(text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Context Before (lines)"; }
                                        LineEdit {
                                            text <=> root.set-context-before;
                                            input-type: number;
                                            edited(text) => { root.save-context-before(text); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        FieldLabel { text: "Context After (lines)"; }
                                        LineEdit {
                                            text <=> root.set-context-after;
                                            input-type: number;
                                            edited(text) => { root.save-context-after(text); }
                                        }
                                    }
                                }
                                CheckBox {
                                    text: "Write translations to tl/None (for games without a language menu)";
                                    checked <=> root.set-export-to-none;
                                    toggled => { root.save-export-to-none(self.checked); }
                                }
                            }
                        }

                        if root.section == 2 : SectionCard {
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                SectionTitle { text: "Translation Prompt"; }
                                Text {
                                    text: "Placeholders: {source_language} {target_language} {glossary}";
                                    font-size: 11px;
                                    color: #888;
                                }
                                Rectangle {
                                    min-height: 300px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: #d5d8e0;
                                    background: white;
                                    TextEdit {
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> root.set-prompt;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                    }
                                }
                                Text {
                                    text: "Saved automatically as you type.";
                                    font-size: 11px;
                                    color: #888;
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }
        }

        // ================================================== status bar
        Rectangle {
            height: 28px;
            background: #f2f3f7;
            HorizontalLayout {
                padding-left: 10px;
                Text {
                    text: root.status-message == "" ? "Changes are saved automatically." : root.status-message;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: #444;
                    overflow: elide;
                }
            }
        }
    }

    // Delete-confirmation modal. Last child of the window so it renders
    // on top of every tab.
    if root.confirm-visible : ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.confirm-title;
        message: root.confirm-message;
        accepted => { root.confirm-delete(); }
        rejected => { root.cancel-delete(); }
    }

    // AI-profile add/edit form as a modal overlay, above everything else.
    if root.ed-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {} // swallow clicks — never close a half-edited form
        Rectangle {
            width: min(780px, parent.width - 40px);
            height: min(560px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000045;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "AI Profile";
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        source: @image-url("assets/x.svg");
                        clicked => { root.ed-cancel(); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "Profile Name"; }
                        LineEdit { text <=> root.ed-name; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        width: 170px;
                        FieldLabel { text: "Preset"; }
                        ComboBox {
                            model: ["OpenAI (cloud)", "Ollama Cloud (API key)", "Ollama (local)", "LM Studio (local)", "OpenRouter", "Custom"];
                            current-index <=> root.ed-preset;
                            selected(text) => { root.ed-apply-preset(text); }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    FieldLabel { text: "API Endpoint (OpenAI-compatible)"; }
                    LineEdit { text <=> root.ed-endpoint; }
                }

                VerticalLayout {
                    spacing: 2px;
                    FieldLabel { text: "API Key (empty = not sent, for local servers)"; }
                    LineEdit { text <=> root.ed-api-key; input-type: password; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;
                        FieldLabel { text: "Model"; }
                        HorizontalLayout {
                            spacing: 4px;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.ed-model-items;
                                current-index <=> root.ed-model-index;
                                selected(text) => { root.ed-apply-model(text); }
                            }
                            IconButton {
                                source: @image-url("assets/refresh.svg");
                                clicked => { root.ed-refresh-models(); }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        width: 110px;
                        FieldLabel { text: "Temperature"; }
                        LineEdit {
                            text <=> root.ed-temperature;
                            input-type: number;
                        }
                    }
                }

                Text {
                    text: "Thinking / reasoning is always disabled for Ollama providers.";
                    font-size: 11px;
                    color: #888;
                }

                if root.ed-error != "" : Text {
                    text: root.ed-error;
                    font-size: 12px;
                    color: #c62828;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: "Confirm";
                        primary: true;
                        clicked => { root.ed-confirm(); }
                    }
                    DialogButton {
                        label: "Cancel";
                        clicked => { root.ed-cancel(); }
                    }
                }
            }
        }
    }

    // Folder picker overlay — replaces the native file dialog.
    // "" in fp-path means the drive list.
    if root.fp-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {} // swallow clicks — pickers close via their buttons
        Rectangle {
            width: min(640px, parent.width - 40px);
            height: min(460px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000045;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Select the game folder";
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        source: @image-url("assets/x.svg");
                        clicked => { root.fp-cancel(); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        text <=> root.fp-path;
                        horizontal-stretch: 1;
                        placeholder-text: "Type a path (e.g. D:\\Games) and press Enter";
                        accepted(text) => { root.fp-go(); }
                    }
                    DialogButton {
                        label: "Go";
                        clicked => { root.fp-go(); }
                    }
                }

                Rectangle {
                    clip: true;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e4ea;
                    vertical-stretch: 1;
                    ListView {
                        for item in root.fp-items: Rectangle {
                            height: 30px;
                            ta := TouchArea {
                                clicked => { root.fp-navigate(item); }
                                mouse-cursor: pointer;
                            }
                            background: ta.has-hover ? #eef2fb : transparent;
                            Text {
                                x: 10px;
                                text: item;
                                vertical-alignment: center;
                                color: item == ".." ? #888 : #333;
                            }
                        }
                    }
                }

                if root.fp-status != "" : Text {
                    text: root.fp-status;
                    font-size: 12px;
                    color: #c62828;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: "Select Folder";
                        primary: true;
                        clicked => { root.fp-confirm(); }
                    }
                    DialogButton {
                        label: "Cancel";
                        clicked => { root.fp-cancel(); }
                    }
                }
            }
        }
    }

    // AI glossary proposals review overlay.
    if root.gp-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {} // swallow clicks — review closes via its buttons
        Rectangle {
            width: min(720px, parent.width - 40px);
            height: min(520px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000045;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "AI Glossary Proposals";
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.gp-rows.length + " terms";
                        font-size: 12px;
                        color: #888;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        source: @image-url("assets/x.svg");
                        clicked => { root.gp-visible = false; } // keep for later
                    }
                }

                Rectangle {
                    height: 26px;
                    background: #eef0f5;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px; // matches the row delegates below
                        Text { text: "Term"; width: 240px; font-weight: 600; vertical-alignment: center; }
                        Text { text: "Translation"; horizontal-stretch: 1; font-weight: 600; vertical-alignment: center; }
                        Text { text: "Freq"; width: 50px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        Text { text: ""; width: 76px; }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for p[ix] in root.gp-rows: Rectangle {
                        height: 34px;
                        background: Math.mod(ix, 2) == 0 ? white : #f7f8fb;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                Text { text: p.source; width: 240px; overflow: elide; vertical-alignment: center; }
                                Text { text: p.target; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                Text {
                                    text: p.occurrences;
                                    width: 50px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: #888;
                                }
                                Rectangle {
                                    width: 76px;
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        IconButton {
                                            source: @image-url("assets/check.svg");
                                            clicked => { root.gp-accept(p.id); }
                                        }
                                        IconButton {
                                            source: @image-url("assets/trash.svg");
                                            clicked => { root.gp-reject(p.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                if root.gp-rows.length == 0 : Text {
                    text: "No proposals. Run Extract with AI from the Glossary page.";
                    color: #888;
                    horizontal-alignment: center;
                }

                if root.gp-status != "" : Text {
                    text: root.gp-status;
                    font-size: 12px;
                    color: #c62828;
                    overflow: elide;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: "Accept All";
                        primary: true;
                        enabled: root.gp-rows.length > 0;
                        clicked => { root.gp-accept-all(); }
                    }
                    DialogButton {
                        label: "Discard";
                        danger: true;
                        enabled: root.gp-rows.length > 0;
                        clicked => { root.gp-discard(); }
                    }
                }
            }
        }
    }

    // Bulk re-translate confirmation.
    if root.rt-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {}
        rt_fs := FocusScope {
            width: parent.width;
            height: parent.height;
            init => { rt_fs.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.rt-cancel();
                    accept
                } else {
                    reject
                }
            }
            Rectangle {
                width: min(470px, parent.width - 40px);
                height: min(300px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: white;
                border-radius: 12px;
                drop-shadow-blur: 28px;
                drop-shadow-color: #00000045;
                VerticalLayout {
                    padding: 22px;
                    spacing: 12px;

                    Text {
                        text: "Re-translate";
                        font-size: 16px;
                        font-weight: 700;
                        color: #1a1a1a;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Scope";
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            horizontal-stretch: 1;
                            model: ["Current search / filter results", "Whole project"];
                            current-index <=> root.rt-scope;
                        }
                    }

                    CheckBox {
                        text: "Ignore translation memory (translate fresh)";
                        checked <=> root.rt-ignore-tm;
                    }

                    Text {
                        text: "Existing translations inside the scope will be replaced.";
                        font-size: 12px;
                        color: #b58900;
                        wrap: word-wrap;
                    }

                    Rectangle { vertical-stretch: 1; }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        DialogButton {
                            label: "Cancel";
                            clicked => { root.rt-cancel(); }
                        }
                        DialogButton {
                            label: "Re-translate";
                            danger: true;
                            clicked => { root.rt-confirm(); }
                        }
                    }
                }
            }
        }
    }

    // QA report overlay.
    if root.qa-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {}
        Rectangle {
            width: min(760px, parent.width - 40px);
            height: min(540px, parent.height - 40px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 28px;
            drop-shadow-color: #00000045;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "QA Report";
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.qa-summary;
                        font-size: 12px;
                        color: #888;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        source: @image-url("assets/x.svg");
                        clicked => { root.qa-visible = false; }
                    }
                }

                Rectangle {
                    height: 26px;
                    background: #eef0f5;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 4px; // matches the row delegates below
                        Text { text: "Location"; width: 260px; font-weight: 600; vertical-alignment: center; }
                        Text { text: "Issue"; horizontal-stretch: 1; font-weight: 600; vertical-alignment: center; }
                    }
                }

                Rectangle {
                    clip: true;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e4ea;
                    vertical-stretch: 1;
                    ListView {
                        for q[ix] in root.qa-rows: Rectangle {
                            height: 34px;
                            qa_ta := TouchArea {
                                clicked => { root.qa-jump(q.id); }
                                mouse-cursor: pointer;
                            }
                            background: qa_ta.has-hover ? #fdeaea : Math.mod(ix, 2) == 0 ? white : #fdf5f5;
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                Text {
                                    text: q.loc;
                                    width: 260px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: #666;
                                }
                                Text {
                                    text: q.label;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                    color: #8a1f1f;
                                }
                            }
                        }
                    }
                }

                Text {
                    text: "Click an issue to jump to the entry.";
                    font-size: 11px;
                    color: #888;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    DialogButton {
                        label: "Close";
                        primary: true;
                        clicked => { root.qa-visible = false; }
                    }
                }
            }
        }
    }

    // Find & Replace overlay (translations only).
    if root.fr-visible : Rectangle {
        width: root.width;
        height: root.height;
        background: #00000066;
        TouchArea {}
        fr_fs := FocusScope {
            width: parent.width;
            height: parent.height;
            init => { fr_fs.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.fr-cancel();
                    accept
                } else {
                    reject
                }
            }
            Rectangle {
                width: min(560px, parent.width - 40px);
                height: min(480px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: white;
                border-radius: 12px;
                drop-shadow-blur: 28px;
                drop-shadow-color: #00000045;
                VerticalLayout {
                    padding: 22px;
                    spacing: 10px;

                    Text {
                        text: "Find & Replace — translations only";
                        font-size: 16px;
                        font-weight: 700;
                        color: #1a1a1a;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Find"; width: 90px; vertical-alignment: center; font-size: 13px; }
                        LineEdit {
                            text <=> root.fr-find;
                            horizontal-stretch: 1;
                            placeholder-text: "text to find";
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Replace"; width: 90px; vertical-alignment: center; font-size: 13px; }
                        LineEdit {
                            text <=> root.fr-replace;
                            horizontal-stretch: 1;
                            placeholder-text: "replacement text";
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        CheckBox {
                            text: "Match case";
                            checked <=> root.fr-case;
                        }
                        CheckBox {
                            text: "Whole word";
                            checked <=> root.fr-word;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Preview";
                            clicked => { root.fr-preview-run(); }
                        }
                    }

                    Rectangle {
                        clip: true;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #e2e4ea;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            Text {
                                text: root.fr-count;
                                font-size: 12px;
                                font-weight: 600;
                                color: #444;
                            }
                            ListView {
                                for p in root.fr-preview: Text {
                                    height: 22px;
                                    text: p;
                                    font-size: 11px;
                                    color: #555;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        DialogButton {
                            label: "Replace All";
                            danger: true;
                            clicked => { root.fr-replace-all(); }
                        }
                        DialogButton {
                            label: "Cancel";
                            clicked => { root.fr-cancel(); }
                        }
                    }
                }
            }
        }
    }
}
